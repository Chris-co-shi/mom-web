{
  "name": "mom-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Industrial MOM web applications and design artifacts",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mom/mom-admin dev",
    "dev:admin": "pnpm --filter @mom/mom-admin dev",
    "dev:supplier": "pnpm --filter @mom/supplier-portal dev",
    "dev:customer": "pnpm --filter @mom/customer-portal dev",
    "build": "pnpm -r --filter '@mom/*' --if-present run build",
    "check:type": "pnpm -r --filter '@mom/*' --if-present run typecheck",
    "validate": "node scripts/validate.mjs && node scripts/validate-s08-ports.mjs && node scripts/validate-s00-baseline.mjs",
    "lint": "eslint apps packages/access packages/api-client packages/auth packages/common-ui packages/design-tokens packages/domain-components packages/first-party-auth packages/iam-admin packages/portal-access packages/security-e2e packages/shared packages/system-client packages/traceability-graph scripts tests eslint.config.mjs playwright.config.ts vitest.config.ts",
    "stylelint": "stylelint \"apps/**/*.{css,vue}\" \"packages/{common-ui,design-tokens}/src/**/*.{css,vue}\" && node scripts/check-style-tokens.mjs",
    "tokens:generate": "pnpm --filter @mom/design-tokens generate",
    "tokens:check": "node scripts/check-tokens.mjs",
    "bundle:check": "node scripts/check-bundle.mjs --profile=baseline",
    "bundle:target": "node scripts/check-bundle.mjs --profile=target",
    "bundle:target:portal": "node scripts/check-bundle.mjs --profile=target --application=supplier-portal --application=customer-portal",
    "test:auth": "rm -rf .tmp/auth-test && tsc -p tsconfig.test.json && node --test .tmp/auth-test/auth/src/index.test.js .tmp/auth-test/first-party-auth/src/index.test.js .tmp/auth-test/api-client/src/index.test.js .tmp/auth-test/iam-admin/src/index.test.js .tmp/auth-test/portal-access/src/index.test.js .tmp/auth-test/security-e2e/src/index.test.js",
    "test:admin-runtime": "rm -rf .tmp/admin-runtime-test && tsc -p tsconfig.admin-runtime-test.json && node --test .tmp/admin-runtime-test/section-navigation.test.js",
    "test:admin-ui": "node --test apps/mom-admin/src/ui-regression.test.mjs",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component --environment=jsdom",
    "test:e2e": "playwright test",
    "test": "pnpm run test:auth && pnpm run test:admin-runtime && pnpm run test:admin-ui && pnpm run test:unit",
    "check": "pnpm run validate && pnpm run lint && pnpm run stylelint && pnpm run tokens:check && pnpm run check:type && pnpm run test && pnpm run test:component"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "3.5.34",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "17.8.0",
    "jsdom": "^30.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.0.10",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
