    "supplier-portal": {
      "dist": "apps/supplier-portal/dist",
      "initialGzipBytes": 256000,
      "maxChunkBytes": 512000
    },
    "customer-portal": {
      "dist": "apps/customer-portal/dist",
      "initialGzipBytes": 256000,
      "maxChunkBytes": 512000
    }
  }
}
