{
  "name": "mom-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GEO Manufacturing Platform web application",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "tdesign-vue-next": "1.20.9",
    "vue": "3.5.34",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "3.5.34",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.0.10",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.5"
  }
}
